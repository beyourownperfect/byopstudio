# BYOPGateCS.studio — Frontend Environment Variables
# Copy this file to .env and fill in your values.

# Backend API URL (no trailing slash).
# Local dev with separate backend on port 8000:
#   REACT_APP_BACKEND_URL=http://127.0.0.1:8000
# Render single-service deployment (frontend and backend on same origin):
#   Leave this empty or unset — the app will use /api on the same origin.
REACT_APP_BACKEND_URL=
